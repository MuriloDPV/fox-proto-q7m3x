---
// ABERTURA DE ABA: o primeiro bloco de toda aba (menos o Início, que tem a
// AberturaInicio.astro). As abas usam sempre
//   <HeroAba {...fotos.abertura} rotulo="..." linhas={[...]}>frase + botão</HeroAba>
// e não precisam saber qual modelo vai aparecer: quem escolhe é o
// arquivo central src/dados/fotos-secoes.js (campo "tipo").
//
// Regra da v4.5: NENHUM texto em cima de foto. Por isso a antiga abertura
// "tela cheia com título gigante por cima" saiu, e sobraram dois modelos:
//   tipo: 'dividida'  -> HeroDividido.astro: texto à esquerda, foto à direita
//   tipo: 'empilhada' -> HeroEmpilhado.astro: texto em cima, no creme, e
//                        logo abaixo a foto larga (cinema) com topo em arco
// As abas vizinhas alternam os dois modelos (ver fotos-secoes.js).
import HeroDividido from './HeroDividido.astro';
import HeroEmpilhado from './HeroEmpilhado.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  foto: { src: ImageMetadata; alt: string; real: number; telaCheia?: boolean };
  tipo: 'dividida' | 'empilhada'; // vem de fotos-secoes.js
  posicao?: string; // object-position (que parte da foto fica visível)
  rotulo: string; // texto pequeno acima do título
  linhas: string[]; // o título, uma linha por item (no máximo 2)
  nivel?: 'h1' | 'h2';
  carregar?: 'eager' | 'lazy';
}

const { tipo, ...resto } = Astro.props;

if (tipo !== 'dividida' && tipo !== 'empilhada') {
  throw new Error(`HeroAba: tipo "${tipo}" não existe. Use 'dividida' ou 'empilhada' em src/dados/fotos-secoes.js.`);
}

const Modelo = tipo === 'empilhada' ? HeroEmpilhado : HeroDividido;
---

<Modelo {...resto}>
  <slot />
</Modelo>
