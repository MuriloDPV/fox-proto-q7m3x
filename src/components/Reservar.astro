---
// Janela "Reservar": a busca de datas que abre de qualquer aba.
// Qualquer botão com data-abrir-busca abre esta janela (o "Reservar" do
// topo e do menu, o "Ver datas" de cada acomodação, o botão do Início).
// Se o botão tiver data-acomodacao e data-hospedes, a janela mostra o nome
// e já escolhe o número de hóspedes. Lógica em src/scripts/reservar.js.
// <dialog> + showModal(): o navegador cuida do foco, do Esc e do fundo.
import Busca from './Busca.astro';
import Icone from './Icone.astro';
import { linkWhatsApp, MENSAGEM_RESERVA, MOTOR_RESERVAS_URL } from '../config.js';
---

<dialog class="reservar" id="reservar" aria-labelledby="reservar-titulo">
  <div class="reservar__caixa">
    <button class="reservar__fechar rotulo" type="button" data-fechar>Fechar</button>
    <p class="rotulo">Reservar</p>
    <h2 class="titulo" id="reservar-titulo">Escolha <em>as datas</em></h2>
    <p class="reservar__acomodacao" data-reservar-acomodacao hidden></p>
    <Busca id="busca-janela" rotulo="Buscar" />
    <p class="reservar__nota">
      A busca abre o motor de reservas em outra aba, já com as datas. Lá aparecem as acomodações livres, os valores
      e a <a class="link" href={MOTOR_RESERVAS_URL} target="_blank" rel="noopener">política de cancelamento</a>.
    </p>
    <a class="botao" href={linkWhatsApp(MENSAGEM_RESERVA)} target="_blank" rel="noopener">
      <span class="botao__texto"><Icone nome="whatsapp" /> Reservar pelo WhatsApp</span>
    </a>
  </div>
</dialog>

<style>
  .reservar {
    width: min(100% - 2 * var(--margem), 760px);
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--texto);
    overflow: visible;
  }

  .reservar::backdrop {
    background: rgb(42 32 25 / 0.55);
  }

  .reservar__caixa {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 1.3rem;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    padding: clamp(1.8rem, 4.5vw, 3.2rem);
    background: var(--fundo);
    border-top: 2px solid var(--ouro);
  }

  /* abre subindo de leve */
  .reservar[open] .reservar__caixa {
    animation: reservar-abre 0.6s var(--ease) both;
  }

  @keyframes reservar-abre {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .reservar h2 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }

  .reservar__acomodacao {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--ouro);
    font-size: 0.92rem;
  }

  .reservar__acomodacao[hidden] {
    display: none;
  }

  .reservar :global(.busca) {
    width: 100%;
    margin-block: 0.6rem;
  }

  .reservar__nota {
    max-width: 36rem;
    font-size: 0.88rem;
    color: var(--texto-suave);
  }

  .reservar__fechar {
    position: absolute;
    top: 1.1rem;
    right: 1.2rem;
    padding: 0.6rem 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
</style>
