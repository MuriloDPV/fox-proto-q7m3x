---
// Abertura do Início.
// v4.8: abre com UMA foto grande (o pátio iluminado ao anoitecer) e pouco
// texto. A foto vem primeiro, sem nada escrito em cima (regra da v4.5); o
// título curto fica logo abaixo dela, no creme. A frase longa e a cidade
// saíram da abertura. Os três pilares e a busca de datas continuam, mais
// abaixo. Com a foto do pátio aqui em cima, o bloco PanoramaInicio (que
// repetia a mesma foto) saiu da aba Início.
// A foto NÃO entra na cascata de src/scripts/entrada.js: ela já está no
// lugar quando o arco da entrada abre, então o arco revela o pátio.
import Linhas from './Linhas.astro';
import Busca from './Busca.astro';
import Foto from './Foto.astro';
import Icone from './Icone.astro';
import { SECOES } from '../dados/fotos-secoes.js';
const pilares = SECOES.inicio.pilares;
const heroi = SECOES.inicio.abertura; // { foto: FOTOS.heroPatio, posicao }
// Recorte da foto na abertura: 30% de cima = mostra o céu do entardecer e a
// profundidade do pátio (com 60%, o corte do computador comia quase todo o
// céu). No celular a caixa é em pé e a foto aparece na altura inteira, então
// só o computador sente a diferença. (O menu em tela cheia continua usando
// heroi.posicao, de fotos-secoes.js.)
const POSICAO_FOTO = '50% 30%';
---

<header class="abertura-inicio margem" data-entrada="inicio">
  <div class="ai-foto">
    <Foto {...heroi.foto} posicao={POSICAO_FOTO} formato="cinema"
      galeria="patio-inicio" sizes="(min-width: 900px) 96vw, 230vw"
      carregar="eager" revelar={false} />
  </div>

  <div class="ai-texto">
    <p class="rotulo ai-rotulo" data-entrada="rotulo">Pousada · arte · natureza</p>
    <div data-entrada="titulo">
      <Linhas tag="h1" class="titulo-abertura ai-titulo" linhas={['Esculturas, estadias', '<em>e celebrações</em>']} rolagem={false} />
    </div>
    <a class="ai-explorar" href="#experiencias" data-entrada="apoio">Explore a chácara <Icone nome="seta" /></a>
  </div>

  <ul class="ai-pilares" aria-label="Três maneiras de viver a Chácara Ludwig">
    {pilares.map((p, i) => (
      <li data-entrada="pilar">
        <span class="ai-numero" aria-hidden="true" data-entrada="apoio">0{i + 1}</span>
        <Foto {...p.foto} posicao={p.posicao} formato="retrato"
          href={p.href} legenda={p.legenda} detalhe={p.detalhe}
          sizes="(min-width: 900px) 20vw, 30vw" carregar="eager" revelar={false} />
      </li>
    ))}
  </ul>

  <div class="ai-reserva" data-entrada="busca">
    <div class="ai-reserva__intro">
      <p class="rotulo">Seu próximo descanso</p>
      <h2>Planeje <em>sua estadia</em></h2>
    </div>
    <Busca id="busca-abertura" rotulo="Consultar datas" />
    <p class="ai-reserva__nota">Café da manhã incluso <span aria-hidden="true">·</span> Check-in 14h <span aria-hidden="true">·</span> Check-out 10h30</p>
  </div>
</header>

<style>
  .abertura-inicio {
    display: grid; gap: 2rem;
    padding-top: calc(var(--altura-topo) + 1rem); padding-bottom: 0.5rem;
  }
  /* A foto grande. Celular: caixa em pé (4:5), no máximo ~60% da altura
     da tela, para o título aparecer logo abaixo sem rolar.
     Computador: faixa larga, no máximo ~58% da altura da tela (o título
     aparece embaixo sem rolar). */
  .ai-foto :global(.foto.foto--cinema .foto__caixa) { aspect-ratio: 4 / 5; max-height: 60svh; }
  .ai-foto :global(.foto__img) { width: 100%; height: 100%; object-fit: cover; }
  .ai-texto { display: grid; gap: 1rem; align-content: center; }
  .ai-rotulo { color: var(--ouro-escuro); }
  .ai-titulo { font-size: clamp(2.55rem, 5vw, 4.8rem); }
  .ai-explorar {
    display: inline-flex; align-items: center; justify-self: start; gap: 1.3rem;
    padding-block: 0.4rem; border-bottom: 1px solid var(--ouro);
    text-decoration: none; font-size: 0.85rem;
  }
  .ai-explorar :global(svg) { width: 1.1rem; height: 1.1rem; transform: rotate(90deg); }
  .ai-pilares {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.65rem;
    margin: 0; padding: 0; list-style: none; align-items: start;
  }
  .ai-pilares li:nth-child(2) { padding-top: 1.2rem; }
  .ai-pilares li:nth-child(3) { padding-top: 2.4rem; }
  .ai-numero { display: block; margin-bottom: 0.55rem; font: 500 0.65rem var(--sans); letter-spacing: 0.14em; color: var(--ouro-escuro); }
  .ai-pilares :global(.legenda) { margin-top: 0.65rem; font-size: 1.2rem; }
  .ai-pilares :global(.legenda small) { display: none; }
  .ai-pilares :global(.foto__img) { transition: transform 1.2s var(--ease); }
  .ai-reserva {
    display: grid; gap: 1.3rem; padding-block: 1.5rem;
    border-top: 1px solid var(--ouro); border-bottom: 1px solid var(--linha);
  }
  .ai-reserva__intro { display: grid; gap: 0.45rem; }
  .ai-reserva__intro .rotulo { color: var(--ouro-escuro); }
  .ai-reserva__intro h2 { font-size: 1.9rem; font-weight: 400; }
  .ai-reserva__nota { color: var(--texto-suave); font-size: 0.72rem; }
  .ai-reserva__nota span { padding-inline: 0.25rem; }
  @media (min-width: 900px) {
    .abertura-inicio {
      grid-template-columns: 0.95fr 1.25fr; align-items: center;
      column-gap: clamp(2rem, 4vw, 5rem); row-gap: clamp(2.2rem, 4vw, 3.5rem);
      padding-top: calc(var(--altura-topo) + clamp(1rem, 2.5vh, 2rem));
    }
    .ai-foto { grid-column: 1 / -1; }
    /* o título fica logo abaixo da foto (não centralizado na altura dos pilares) */
    .ai-texto { align-self: start; }
    .ai-foto :global(.foto.foto--cinema .foto__caixa) { aspect-ratio: 21 / 9; max-height: 58vh; }
    .ai-texto { gap: 1.45rem; }
    .ai-titulo { font-size: clamp(2.75rem, 4.6vw, 4.8rem); }
    .ai-pilares { gap: clamp(0.75rem, 1.5vw, 1.5rem); }
    .ai-pilares li:nth-child(2) { padding-top: 2rem; }
    .ai-pilares li:nth-child(3) { padding-top: 4rem; }
    .ai-pilares :global(.legenda) { font-size: clamp(1.25rem, 1.9vw, 1.8rem); }
    .ai-pilares :global(.legenda small) { display: block; font-size: 0.75rem; line-height: 1.5; }
    .ai-reserva { grid-column: 1 / -1; grid-template-columns: 1fr 2.8fr; gap: 0.7rem 2.5rem; align-items: center; padding-block: 1.3rem 1.1rem; padding-right: 4rem; }
    .ai-reserva__nota { grid-column: 2; }
  }
  @media (max-width: 379px) {
    .ai-titulo { font-size: 2.35rem; }
    .ai-pilares :global(.legenda) { font-size: 1.05rem; }
  }
</style>
