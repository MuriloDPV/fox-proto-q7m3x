---
// ABERTURA DO INÍCIO — "três pilares" (proposta C da v4.2, fixada na v4.3)
// Título, frase e busca à esquerda; à direita, três fotos altas (2:3, como
// pilares) em escada, uma para cada coisa que o lugar oferece (estadia,
// esculturas, eventos), com legenda curta. Cada foto leva para a aba do
// assunto. No celular as três ficam lado a lado, pequenas, embaixo da
// busca: ainda aparecem na primeira tela.
//
// O texto fica no fundo off-white, SEPARADO das fotos (na v4.1 o título
// gigante ficava em cima da foto do pátio e confundia), e a busca de datas
// aparece na primeira tela, sem rolar.
//
// As fotos são as de ~600 px (não temos foto grande de quarto, escultura ou
// evento), então entram pelo componente Foto, que aplica a trava de 1,5×.
// Quais fotos e legendas: src/dados/fotos-secoes.js (inicio.pilares).
//
// ENTRADA (v4.3): cada data-entrada="..." marca uma peça que entra em
// cascata quando o site abre e sempre que se volta para o Início.
//   quem anima ............. src/scripts/entrada.js
//   tempos ................. src/dados/entrada.js
//   estado inicial (oculto)  global.css, "ENTRADA DO SITE"
//   parallax das fotos ..... src/scripts/parallax.js
import Linhas from './Linhas.astro';
import Busca from './Busca.astro';
import Foto from './Foto.astro';
import { SECOES } from '../dados/fotos-secoes.js';

const pilares = SECOES.inicio.pilares;

// O título é o aprovado na v4.1, em caixa normal; a frase explica o lugar
// em 5 segundos.
const titulo = ['Esculturas, estadias', '<em>e celebrações</em>'];
const frase =
  'Pousada com 22 suítes e casas temáticas, jardim com mais de 100 esculturas e réplicas e espaço para eventos.';
---

<header class="abertura-inicio margem" data-entrada="inicio">
  <div class="ai-texto">
    <p class="rotulo ai-rotulo" data-entrada="rotulo">Chácara Ludwig</p>
    <div data-entrada="titulo">
      <Linhas tag="h1" class="ai-titulo" linhas={titulo} rolagem={false} />
    </div>
    <p class="ai-frase" data-entrada="frase">{frase}</p>
    <div class="ai-busca" data-entrada="busca">
      <Busca id="busca-abertura" />
    </div>
  </div>

  <!-- As três fotos. "eager": baixam logo (estão na primeira tela e a
       linha da tela de abertura espera por elas). revelar={false}: quem
       as faz entrar é a sequência de entrada, não a rolagem. -->
  <ul class="ai-pilares">
    {
      pilares.map((p) => (
        <li data-entrada="pilar">
          <Foto
            {...p.foto}
            posicao={p.posicao}
            formato="alto"
            href={p.href}
            legenda={p.legenda}
            detalhe={p.detalhe}
            sizes="(min-width: 900px) 18vw, 30vw"
            carregar="eager"
            revelar={false}
          />
        </li>
      ))
    }
  </ul>
</header>

<style>
  .abertura-inicio {
    /* Título da abertura: no celular ~38px, no computador até ~67px. */
    --t-abertura: clamp(2.35rem, 1rem + 3.4vw, 4.2rem);
    /* respiro vertical em volta do texto (acompanha a altura da tela) */
    --respiro: clamp(1.75rem, 5.5vh, 3.75rem);
  }

  /* ---- Celular: texto, busca e as três fotos lado a lado ---- */
  .abertura-inicio {
    display: grid;
    gap: calc(var(--respiro) * 0.8);
    padding-top: calc(var(--altura-topo) + var(--respiro));
  }

  .ai-texto {
    display: grid;
    gap: 1rem;
  }

  .ai-rotulo {
    color: var(--ouro-escuro);
  }

  .abertura-inicio :global(.ai-titulo) {
    font: 300 var(--t-abertura) / 1.02 var(--serifa);
    letter-spacing: -0.015em;
  }

  .abertura-inicio :global(.ai-titulo em) {
    font-style: italic;
  }

  /* a frase que explica o lugar */
  .ai-frase {
    max-width: 25rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--texto-suave);
  }

  .ai-busca {
    margin-top: 0.8rem;
  }

  .ai-pilares {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* a escada: cada foto um degrau abaixo da anterior */
  .ai-pilares li:nth-child(2) {
    margin-top: 1rem;
  }

  .ai-pilares li:nth-child(3) {
    margin-top: 2rem;
  }

  /* (a foto mantém uma transição curta: é ela que faz a volta suave do
     zoom do hover) */
  .ai-pilares :global(.foto__img) {
    transition: transform 1.2s var(--ease);
  }

  /* legenda pequena no celular, sem a linha de detalhe (não cabe) */
  .ai-pilares :global(.legenda) {
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }

  .ai-pilares :global(.legenda small) {
    display: none;
  }

  /* ---- Computador: texto à esquerda (5 colunas), escada à direita ---- */
  @media (min-width: 900px) {
    .abertura-inicio {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--vao);
      align-items: center;
      min-height: min(100svh, 60rem);
      padding-top: calc(var(--altura-topo) + var(--respiro) * 0.6);
      padding-bottom: var(--respiro);
    }

    .ai-texto {
      grid-column: 1 / 6;
      padding-right: var(--vao);
    }

    .ai-busca :global(.busca) {
      grid-template-columns: 1fr 1fr;
    }

    .ai-busca :global(.busca__botao) {
      justify-self: stretch;
    }

    .ai-pilares {
      grid-column: 7 / -1;
      gap: var(--vao);
    }

    .ai-pilares li:nth-child(2) {
      margin-top: clamp(2rem, 7vh, 4.5rem);
    }

    .ai-pilares li:nth-child(3) {
      margin-top: clamp(4rem, 14vh, 9rem);
    }

    .ai-pilares :global(.legenda) {
      margin-top: 0.8rem;
      font-size: var(--t-medio);
    }

    .ai-pilares :global(.legenda small) {
      display: block;
    }
  }
</style>
