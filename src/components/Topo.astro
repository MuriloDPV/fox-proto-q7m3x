---
// TOPO MÍNIMO (v4): "Reservar" à esquerda, logo no centro, "Menu" à direita.
// Começa transparente, por cima da foto de abertura de cada aba (texto
// claro e logo para fundo escuro). Depois de rolar a foto, ganha fundo
// off-white, texto escuro e a logo para fundo claro. Rolando para baixo
// ele se esconde; rolando para cima, volta. (src/scripts/topo.js)
// O menu em tela cheia fica em Menu.astro (src/scripts/menu.js).
// data-entrada: peças que entram na abertura do site (src/scripts/entrada.js;
// a logo daqui é o ponto de pouso da logo que voa da tela de abertura).
import { Image } from 'astro:assets';
import logoClara from '../assets/marca/logo-clara.png';
import logoEscura from '../assets/marca/logo-escura.png';
---

<header class="topo" id="topo">
  <button class="topo__acao topo__reservar" type="button" data-abrir-busca data-entrada="topo-botao">Reservar</button>

  <a class="topo__logo" data-entrada="topo-logo" href="#inicio" aria-label="Chácara Ludwig — voltar ao início">
    <!-- duas versões da logo, uma em cima da outra; o CSS mostra a certa -->
    <Image class="topo__logo-img topo__logo-img--foto" src={logoEscura} alt="" widths={[120, 180, 240]} sizes="90px" loading="eager" />
    <Image class="topo__logo-img topo__logo-img--papel" src={logoClara} alt="" widths={[120, 180, 240]} sizes="90px" loading="eager" />
  </a>

  <button class="topo__acao topo__menu" data-entrada="topo-botao" type="button" aria-expanded="false" aria-controls="menu" data-abrir-menu>
    <span class="topo__menu-abrir">Menu</span>
    <span class="topo__menu-fechar" aria-hidden="true">Fechar</span>
  </button>
</header>

<style>
  .topo {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90; /* acima do menu em tela cheia (80) */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--altura-topo);
    padding-inline: var(--margem);
    color: var(--sobre-foto);
    view-transition-name: topo; /* fica parado durante a troca de aba */
    transition:
      transform 0.6s var(--ease),
      color 0.4s;
  }

  /* Fundo off-white: uma camada separada (::before) que aparece com
     opacity, para a troca ser suave. Na entrada do site (v4.3) o filete
     de baixo se desenha do centro para as pontas (transform: scaleX). */
  .topo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--fundo);
    box-shadow: 0 1px 0 var(--linha);
    opacity: 0;
    transition:
      opacity 0.4s,
      transform 0.9s var(--ease);
  }

  /* ---- Estados (classes colocadas pelo topo.js e pelo menu.js) ---- */
  :global(.topo.topo--solido),
  :global(body.menu-aberto) .topo {
    color: var(--texto);
  }

  :global(.topo.topo--solido)::before {
    opacity: 1;
  }

  :global(.topo.topo--escondido) {
    transform: translateY(-100%);
  }

  /* com o menu aberto, o topo nunca se esconde e fica sem fundo
     (o menu já é off-white) */
  :global(body.menu-aberto) .topo {
    transform: none;
  }

  :global(body.menu-aberto) .topo::before {
    opacity: 0;
  }

  /* ---- Botões de texto (Reservar e Menu) ---- */
  .topo__acao {
    position: relative;
    justify-self: start;
    padding: 0.8rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: 500 var(--t-rotulo) / 1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .topo__menu {
    justify-self: end;
  }

  /* filete dourado embaixo do texto, que cresce no hover */
  .topo__acao::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.45rem;
    height: 1px;
    background: var(--ouro);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }

  /* "Reservar" sempre com o filete: é o botão principal */
  .topo__reservar::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .topo__acao:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  /* troca Menu ↔ Fechar */
  .topo__menu-fechar {
    position: absolute;
    right: 0;
    opacity: 0;
  }

  .topo__menu[aria-expanded='true'] .topo__menu-abrir {
    opacity: 0;
  }

  .topo__menu[aria-expanded='true'] .topo__menu-fechar {
    opacity: 1;
  }

  /* ---- Logo ---- */
  .topo__logo {
    position: relative;
    display: block;
    width: 56px;
    aspect-ratio: 612 / 519; /* proporção do arquivo da logo */
    transform-origin: 50% 30%;
    transition: transform 0.6s var(--ease);
  }

  .topo__logo :global(.topo__logo-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.4s;
  }

  .topo__logo :global(.topo__logo-img--papel) {
    opacity: 0;
  }

  :global(.topo.topo--solido) .topo__logo :global(.topo__logo-img--foto),
  :global(body.menu-aberto) .topo__logo :global(.topo__logo-img--foto) {
    opacity: 0;
  }

  :global(.topo.topo--solido) .topo__logo :global(.topo__logo-img--papel),
  :global(body.menu-aberto) .topo__logo :global(.topo__logo-img--papel) {
    opacity: 1;
  }

  /* sobre a foto a logo fica um pouco maior; no topo sólido, encolhe */
  .topo__logo {
    transform: translateY(6px) scale(1.18);
  }

  :global(.topo.topo--solido) .topo__logo {
    transform: none;
  }

  @media (min-width: 900px) {
    .topo__logo {
      width: 74px;
    }
  }
</style>
