---
// NOTA NO GOOGLE (v4.8): a avaliação pública da chácara no Google.
// Fica embaixo da foto grande do par de fotos do Início (slot "grande" do
// ParFotos): no computador preenche o vão da coluna da direita.
// Dados conferidos na busca do Google em 11/11/2026: nota 4,9, com 433
// avaliações. Ao atualizar, troque NOTA e AVALIACOES aqui (o total aparece
// arredondado para baixo, "+430", no mesmo estilo dos números).
//
// Animação (quando o bloco entra na tela, via data-surgir + revelar.js):
//   - a nota conta de 0,0 até 4,9 (data-contar + data-casas, numeros.js);
//   - as cinco estrelas acendem uma por uma, da esquerda para a direita;
//   - o total conta até +430.
// Com "menos movimento" ligado, tudo aparece pronto, sem animar.
import Icone from './Icone.astro';
import { MAPA_AVALIACOES } from '../config.js';

const NOTA = 4.9;
const AVALIACOES = 433;
const arredondado = Math.floor(AVALIACOES / 10) * 10;
const notaTexto = NOTA.toLocaleString('pt-BR', { minimumFractionDigits: 1 });
---

<div class="nota" data-surgir>
  <p class="rotulo nota__rotulo">Avaliação no Google</p>
  <div class="nota__valor">
    <span class="nota__numero" data-contar={NOTA} data-casas="1">{notaTexto}</span>
    <span class="nota__estrelas" role="img" aria-label={`Nota ${notaTexto} de 5`}>
      {[0, 1, 2, 3, 4].map((i) => <span class="estrela" aria-hidden="true" style={`--i: ${i}`}>★</span>)}
    </span>
  </div>
  <p class="nota__total">+<span data-contar={arredondado}>{arredondado}</span> avaliações no Google</p>
  <a class="nota__link" href={MAPA_AVALIACOES} target="_blank" rel="noopener">
    Ver avaliações <Icone nome="seta" />
  </a>
</div>

<style>
  .nota {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ouro);
  }

  .nota__rotulo {
    color: var(--texto-suave);
  }

  .nota__valor {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }

  /* mesmo tamanho e fonte dos números de "Em números" */
  .nota__numero {
    font: 300 clamp(3rem, 7.4vw, 6.6rem) / 0.9 var(--serifa);
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .nota__estrelas {
    display: inline-flex;
    gap: 0.25em;
    color: var(--ouro);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
  }

  /* Estrelas: começam apagadas e pequenas; quando o bloco fica visível
     (.visivel, posto pelo revelar.js), acendem em sequência (--i = posição). */
  :global(.js) .estrela {
    display: inline-block;
    opacity: 0.18;
    transform: scale(0.6);
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); /* leve "pulo" no fim */
    transition-delay: calc(500ms + var(--i) * 180ms);
  }

  :global(.js) .nota:global(.visivel) .estrela {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .estrela {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .nota__total {
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .nota__link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 1rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--ouro);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .nota__link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
