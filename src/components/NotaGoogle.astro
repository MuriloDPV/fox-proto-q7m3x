---
// NOTA NO GOOGLE (v4.8): a avaliação pública da chácara no Google, entre
// as fotos e os números do Início.
// Dados conferidos na busca do Google em 11/11/2026: nota 4,9, com 433
// avaliações. Ao atualizar, troque NOTA e AVALIACOES aqui (AVALIACOES
// aparece arredondado para baixo, "+430", no mesmo estilo dos números).
// O link abre a ficha da chácara no Google Maps, onde estão as avaliações.
import Icone from './Icone.astro';
import { MAPA_AVALIACOES } from '../config.js';

const NOTA = '4,9';
const AVALIACOES = 433;
const arredondado = Math.floor(AVALIACOES / 10) * 10;
---

<div class="nota secao secao--colada margem">
  <div class="nota__caixa" data-surgir>
    <p class="rotulo nota__rotulo">Avaliação no Google</p>
    <div class="nota__valor">
      <span class="nota__numero">{NOTA}</span>
      <span class="nota__estrelas" role="img" aria-label={`Nota ${NOTA} de 5`}>
        <span aria-hidden="true">★★★★★</span>
      </span>
    </div>
    <p class="nota__total">+{arredondado} avaliações no Google</p>
    <a class="nota__link" href={MAPA_AVALIACOES} target="_blank" rel="noopener">
      Ver avaliações <Icone nome="seta" />
    </a>
  </div>
</div>

<style>
  .nota__caixa {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ouro);
  }

  .nota__rotulo {
    color: var(--texto-suave);
  }

  .nota__valor {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }

  /* mesmo tamanho e fonte dos números de "Em números" */
  .nota__numero {
    font: 300 clamp(3rem, 7.4vw, 6.6rem) / 0.9 var(--serifa);
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
  }

  .nota__estrelas {
    color: var(--ouro);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    letter-spacing: 0.12em;
  }

  .nota__total {
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .nota__link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 1rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--ouro);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .nota__link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* computador: número e estrelas à esquerda, texto e link à direita */
  @media (min-width: 900px) {
    .nota__caixa {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'rotulo rotulo'
        'valor  total'
        'valor  link';
      align-items: end;
      column-gap: clamp(2rem, 5vw, 5rem);
    }
    .nota__rotulo { grid-area: rotulo; }
    .nota__valor { grid-area: valor; }
    .nota__total { grid-area: total; }
    .nota__link { grid-area: link; }
  }
</style>
