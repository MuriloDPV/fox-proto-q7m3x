  quadro:
    '<rect x="3.5" y="4.5" width="17" height="15" rx=".6"/><rect x="6.5" y="7.5" width="11" height="9"/><path d="m6.5 14.5 3.2-3 2.6 2.4 1.7-1.6 3.5 3.2"/><circle cx="14.6" cy="10" r=".9"/>',
  ducha:
    '<path d="M5 21V8a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1"/><path d="M12 9h6"/><path d="M13 12.5l-.5 1.5M15 12.5V14M17 12.5l.5 1.5M13.5 16.5l-.5 1.5M16.5 16.5l.5 1.5"/>',
  tv: '<rect x="3" y="5" width="18" height="12" rx="1.2"/><path d="M8 21h8M12 17v4"/>',
  ar: '<rect x="3" y="5" width="18" height="7" rx="1.2"/><path d="M6 9.5h12"/><path d="M8 15c0 1.5-1 2-1 3.5M12 15c0 1.5-1 2-1 3.5M16 15c0 1.5-1 2-1 3.5"/>',
  wifi: '<path d="M2.5 9a14 14 0 0 1 19 0"/><path d="M5.5 12.3a9.5 9.5 0 0 1 13 0"/><path d="M8.6 15.5a5 5 0 0 1 6.8 0"/><circle cx="12" cy="19" r=".9"/>',
  pessoas:
    '<circle cx="9" cy="8" r="3"/><path d="M3.5 19.5c0-3.2 2.4-5.5 5.5-5.5s5.5 2.3 5.5 5.5"/><path d="M15.5 5.3a3 3 0 0 1 0 5.4M17 14.2c2.1.6 3.5 2.6 3.5 5.3"/>',

  // ---------- eventos ----------
  anel: '<circle cx="12" cy="14.5" r="6"/><path d="M9.6 8.9 8 5.5 10 3h4l2 2.5-1.6 3.4M8 5.5h8"/>',
  coroa: '<path d="M4 17.5h16l1-10-5 4-4-6-4 6-5-4z"/><path d="M4 21h16"/>',
  bolo: '<path d="M4 21h16M5 21v-7h14v7"/><path d="M5 17c1.2 0 1.2 1 2.3 1s1.2-1 2.3-1 1.2 1 2.4 1 1.2-1 2.3-1 1.2 1 2.4 1 1.1-1 2.3-1"/><path d="M8 14v-3M12 14v-3M16 14v-3"/><path d="M8 8.6c-.7-.8 0-1.7 0-2.6.7.9.7 1.8 0 2.6zM12 8.6c-.7-.8 0-1.7 0-2.6.7.9.7 1.8 0 2.6zM16 8.6c-.7-.8 0-1.7 0-2.6.7.9.7 1.8 0 2.6z"/>',
  capelo: '<path d="M2.5 9.5 12 5l9.5 4.5L12 14z"/><path d="M6.5 11.5V16c1.5 1.5 3.5 2.2 5.5 2.2s4-.7 5.5-2.2v-4.5"/><path d="M21.5 9.5v5"/>',
  maleta: '<rect x="3" y="7.5" width="18" height="12" rx="1.5"/><path d="M9 7.5v-2A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5v2"/><path d="M3 12.5h18M10.5 12.5V14h3v-1.5"/>',

  // ---------- gastronomia e lazer ----------
  talheres: '<path d="M7 3v7.5a2 2 0 0 0 2 2V21M11 3v7.5a2 2 0 0 1-2 2M9 3v6"/><path d="M17 21V3c-2 1.5-3 4-3 7v4h3"/>',
  caneca:
    '<path d="M5 8h10v11.5a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 5 19.5z"/><path d="M15 10.5h2a2.5 2.5 0 0 1 2.5 2.5v1a2.5 2.5 0 0 1-2.5 2.5h-2"/><path d="M5 8a2.4 2.4 0 0 1 2.6-3.2 3 3 0 0 1 4.9-.3A2.4 2.4 0 0 1 15 8"/><path d="M8.5 12v5.5M11.5 12v5.5"/>',
  cardapio: '<path d="M5 4h11a2 2 0 0 1 2 2v14H7a2 2 0 0 1-2-2z"/><path d="M5 18a2 2 0 0 1 2-2h11M9 8h5M9 11h5"/>',
  piscina: '<path d="M8 14V5.5a2 2 0 0 1 4 0M15 14V5.5a2 2 0 0 1 4 0M8 8.5h7M8 11.5h7"/>' + '<path d="M3 17.5c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1"/>',
  // cabeça de cavalo de perfil
  cavalo:
    '<path d="M7 21v-4c0-1.8.6-3.2 1.7-4.5L5.3 14.3a1.4 1.4 0 0 1-1.9-.6l-.4-.8a1.4 1.4 0 0 1 .4-1.8L9 6.9l.6-3.4 2.3 2.4c4.4.7 7.6 4.6 7.6 9.6V21"/><circle cx="10.8" cy="9.3" r=".7"/>',
  folha: '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19 13 11"/>',
  balanco: '<path d="M4 21 8 4h8l4 17"/><path d="M10 4v9M14 4v9M9 13h6"/>',

  // ---------- contato ----------
  whatsapp:
    '<path d="M4 20l1.2-4.1A8 8 0 1 1 8.3 19z"/><path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .4-.1.6l-.5.6c.4.9 1.3 1.8 2.3 2.3l.6-.5c.2-.2.4-.2.6-.1l1.5.7c.2.1.3.3.3.5v.5c0 .3-.2.7-.5.8-.6.3-1.6.4-3.1-.3a8.6 8.6 0 0 1-3.2-3.2c-.6-1.4-.5-2.4-.3-2.8z"/>',
  telefone:
    '<path d="M5 4h3.5l1.5 4.2-2 1.3a10 10 0 0 0 6.5 6.5l1.3-2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5C10.6 20 4 13.4 3.5 5.6A1.5 1.5 0 0 1 5 4z"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9"/>',
  facebook: '<path d="M14 21v-7.5h2.6l.4-3H14V8.6c0-.9.3-1.5 1.6-1.5H17V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.7 1.4-3.7 3.9v2.3H8.4v3H11V21"/>',
  relogio: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  rota: '<path d="M12 2.8 21.2 12 12 21.2 2.8 12z"/><path d="M9.5 14.5V12a1.5 1.5 0 0 1 1.5-1.5h4M13 8.5l2 2-2 2"/>',
  estrela: '<path d="m12 3.5 2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.8l-5.3 2.8 1-5.8-4.2-4.1 5.9-.9z"/>',

  // ---------- utilitários ----------
  calendario:
    '<rect x="3.5" y="5" width="17" height="15" rx="1.4"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="m9 14.6 2 2 4-4"/>',
  aspas: '<path d="M4 4.5h16v11H10l-4.5 4v-4H4z"/><path d="M9.2 8.4c-1 .3-1.6 1-1.6 2.2M13.2 8.4c-1 .3-1.6 1-1.6 2.2"/>',
  seta: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  mais: '<path d="M12 5v14M5 12h14"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  fechar: '<path d="M6 6l12 12M18 6 6 18"/>',
};
---

<svg
  class={`icone ${classe}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={desenhos[nome]}
/>
