---
// Ícones de traço fino desenhados para o site (24×24). A cor vem do texto
// (stroke="currentColor"), então o ícone acompanha o hover e a aba ativa.
// Uso: <Icone nome="lareira" />  (nomes na lista "desenhos" abaixo)
interface Props {
  nome: string;
  class?: string;
}

const { nome, class: classe = '' } = Astro.props;

// "ondas" = duas linhas onduladas, reaproveitadas no sol e na piscina
const ondas =
  '<path d="M3 15.5c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1"/><path d="M3 19.5c1.5 0 1.5-1 3-1s1.5 1 3 1 1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1"/>';
// três fiozinhos de vapor/fumaça
const vapor = (y: number) =>
  `<path d="M8.5 ${y}c-.6-1 .6-1.6 0-2.6M12 ${y}c-.6-1 .6-1.6 0-2.6M15.5 ${y}c-.6-1 .6-1.6 0-2.6"/>`;

const desenhos: Record<string, string> = {
  // ---------- abas ----------
  casa: '<path d="M3 11.2 12 4l9 7.2"/><path d="M5.5 9.6v10h13v-10"/><path d="M10 19.6v-4.4a2 2 0 0 1 4 0v4.4"/>',
  cama: '<path d="M3 18.5V6.5"/><path d="M3 14h18v4.5"/><path d="M21 14v-2.4A2.6 2.6 0 0 0 18.4 9H10.5v5"/><circle cx="6.8" cy="11" r="1.8"/>',
  // busto sobre pedestal
  escultura:
    '<circle cx="12" cy="6.2" r="2.9"/><path d="M7 15c0-2.9 2.2-5 5-5s5 2.1 5 5"/><path d="M8 15h8v2.5H8z"/><path d="M9.5 17.5 8.5 21M14.5 17.5l1 3.5M6.5 21h11"/>',
  tacas:
    '<path d="M4.5 3.5h5l-.6 5a1.9 1.9 0 0 1-3.8 0z"/><path d="M7 10.4v8M5 18.5h4"/><path d="M14.5 3.5h5l-.6 5a1.9 1.9 0 0 1-3.8 0z"/><path d="M17 10.4v8M15 18.5h4"/>',
  xicara:
    '<path d="M5 9.5h11v4.5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"/><path d="M16 11h1.5a2.4 2.4 0 0 1 0 4.8H16"/>' + vapor(6.5) + '<path d="M4 21h14"/>',
  // sol sobre a água
  sol: '<circle cx="12" cy="9" r="3.4"/><path d="M12 2.5v1.4M5.6 9H4.2M19.8 9h-1.4M7.4 4.4l1 1M16.6 4.4l-1 1"/>' + ondas,
  // pino de mapa
  mapa: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',

  // ---------- comodidades ----------
  hidro:
    '<path d="M3 12h18v2a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5z"/><path d="M6 12V6.5A2.5 2.5 0 0 1 8.5 4c1.1 0 2 .7 2.3 1.7"/><path d="M7 19l-1 2M17 19l1 2"/><circle cx="14" cy="8.6" r="1"/><circle cx="17.2" cy="6.4" r=".8"/><circle cx="16.8" cy="9.9" r=".6"/>',
  lareira:
    '<path d="M3 4.5h18v3H3zM4.5 7.5V20M19.5 7.5V20M3 20h18"/><path d="M12 18c-2 0-3-1.3-3-2.8 0-1.8 1.6-2.4 1.8-4.2 1.4 1 1.6 2 1.6 2.6.5-.5.7-1 .8-1.6 1 .9 1.8 2 1.8 3.2 0 1.5-1 2.8-3 2.8z"/>',
  geladeira: '<rect x="6" y="3" width="12" height="18" rx="1.5"/><path d="M6 10h12M9 6v2M9 13v3"/>',
  fogao: '<rect x="4" y="9" width="16" height="12" rx="1"/><path d="M4 12.5h16"/><circle cx="8.5" cy="16.7" r="1.9"/><circle cx="15.5" cy="16.7" r="1.9"/>' + vapor(6.5),
  pia: '<path d="M3 13h18v1.5a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 14.5z"/><path d="M10 13V7a2.5 2.5 0 0 1 5 0v1.5"/><path d="M8.5 21h7"/>',
  churrasqueira:
    '<path d="M4 10.5h16a8 8 0 0 1-16 0z"/><path d="M8 17.5 6.5 21M16 17.5l1.5 3.5M12 18.5V21"/>' + vapor(7.5),
  amenities:
