---
// CARROSSEL HORIZONTAL "ARRASTE"
// Uma fileira de fotos que passa da largura da tela. No celular o dedo já
// rola para o lado (é só overflow-x). No computador, o mouse vira um
// círculo escrito "Arraste" e dá para puxar a fileira segurando o botão
// (src/scripts/arrastar.js). Uma linha fina embaixo mostra o quanto já
// foi visto.
//
// Uso:
//   <Arrastar rotulo="O cenário" titulo={['Pátio, pergolado', '<em>e jardins</em>']}
//             fotos={SECOES.eventos.carrossel} galeria="eventos-cenario" />
//   Cada foto pode ter "legenda" e "href" (vira link, ex.: para outra aba).
//   formatos: sequência de formatos que se repete (padrão: retrato, paisagem)
//   O <slot /> (opcional) aparece embaixo da linha de progresso (ex.: um botão).
import Foto from './Foto.astro';
import Linhas from './Linhas.astro';
import type { ImageMetadata } from 'astro';

type Item = { src: ImageMetadata; alt: string; real: number; legenda?: string; detalhe?: string; href?: string };

interface Props {
  rotulo: string;
  titulo?: string[];
  fotos: Item[];
  galeria?: string;
  formatos?: Array<'retrato' | 'paisagem' | 'quadrado'>;
  colada?: boolean;
}

const { rotulo, titulo, fotos, galeria, formatos = ['retrato', 'paisagem'], colada = false } = Astro.props;
---

<section class:list={['arrastar secao', { 'secao--colada': colada }]} data-arrastar aria-label={rotulo}>
  <div class="arrastar__topo margem">
    <p class="rotulo" data-surgir>{rotulo}</p>
    {titulo && <Linhas tag="h2" class="titulo arrastar__titulo" linhas={titulo} />}
    <p class="rotulo arrastar__dica" aria-hidden="true">Arraste para o lado</p>
  </div>

  <!-- tabindex="0": dá para focar a fileira com Tab e rolar com as setas -->
  <ul class="arrastar__trilho" data-trilho-arrastar tabindex="0">
    {
      fotos.map((f, i) => {
        const formato = formatos[i % formatos.length];
        return (
          <li class={`arrastar__item arrastar__item--${formato}`}>
            <Foto
              {...f}
              formato={formato}
              galeria={f.href ? undefined : galeria}
              legenda={f.legenda}
              detalhe={f.detalhe}
              sizes={formato === 'paisagem' ? '(min-width: 900px) 46vw, 84vw' : '(min-width: 900px) 25vw, 56vw'}
              atraso={Math.min(i, 4) * 90}
            />
          </li>
        );
      })
    }
  </ul>

  <div class="arrastar__progresso margem" aria-hidden="true">
    <span class="arrastar__barra"></span>
  </div>

  {
    Astro.slots.has('default') && (
      <div class="arrastar__rodape margem">
        <slot />
      </div>
    )
  }

  <!-- o círculo que segue o mouse (só em computador) -->
  <span class="arrastar__cursor" aria-hidden="true">Arraste</span>
</section>

<style>
  .arrastar {
    position: relative;
    /* altura das fotos: o resto (largura) sai da proporção de cada uma */
    --altura: clamp(14rem, 56vw, 21rem);
    overflow: hidden;
  }

  .arrastar__topo {
    display: grid;
    gap: 1.2rem;
    margin-bottom: clamp(2.4rem, 5vw, 4rem);
  }

  .arrastar__dica {
    color: var(--texto-suave);
  }

  /* ---- Trilho ---- */
  .arrastar__trilho {
    display: flex;
    gap: var(--vao);
    margin: 0;
    padding: 0 var(--margem) 0.5rem;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none; /* a barra de rolagem some; a linha de progresso substitui */
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--margem);
  }

  .arrastar__trilho::-webkit-scrollbar {
    display: none;
  }

  .arrastar__trilho:focus-visible {
    outline-offset: -2px;
  }

  /* No toque, o "ímã" para cada foto alinhada à margem */
  @media (hover: none) {
    .arrastar__trilho {
      scroll-snap-type: x mandatory;
    }

    .arrastar__item {
      scroll-snap-align: start;
    }
  }

  .arrastar__item {
    flex: none;
  }

  .arrastar__item--retrato {
    width: calc(var(--altura) * 0.8);
  }

  .arrastar__item--paisagem {
    width: calc(var(--altura) * 1.5);
  }

  .arrastar__item--quadrado {
    width: var(--altura);
  }

  /* fotos não podem ser "arrastadas" como imagem pelo navegador */
  .arrastar__item :global(img) {
    -webkit-user-drag: none;
    user-select: none;
  }

  /* ---- Linha de progresso ---- */
  .arrastar__progresso {
    margin-top: 2rem;
  }

  .arrastar__progresso::before {
    content: '';
    display: block;
    height: 1px;
    background: var(--linha);
  }

  .arrastar__barra {
    display: block;
    height: 1px;
    margin-top: -1px;
    background: var(--ouro);
    transform-origin: left;
    transform: scaleX(var(--progresso, 0.15));
  }

  .arrastar__rodape {
    margin-top: 2.2rem;
  }

  /* ---- Cursor "Arraste" (só mouse) ---- */
  .arrastar__cursor {
    display: none;
  }

  /* Tela larga: fotos mais altas e o título ao lado da dica */
  @media (min-width: 900px) {
    .arrastar {
      --altura: clamp(20rem, 30vw, 31rem);
    }

    .arrastar__topo {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--vao);
      align-items: end;
    }

    .arrastar__topo > .rotulo:first-child {
      grid-column: 1 / -1;
    }

    .arrastar__topo :global(.arrastar__titulo) {
      grid-column: 1 / 9;
    }

    .arrastar__dica {
      grid-column: 10 / 13;
      justify-self: end;
    }
  }

  /* Mouse: o círculo "Arraste" no lugar da setinha */
  @media (hover: hover) and (pointer: fine) {
    /* o cursor do sistema some só em cima das fotos (o JS liga .com-cursor) */
    :global(.arrastar.com-cursor) .arrastar__trilho {
      cursor: none;
    }

    :global(.arrastar.com-cursor) .arrastar__trilho :global(*) {
      cursor: none;
    }

    .arrastar__cursor {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 5;
      display: grid;
      place-items: center;
      width: 92px;
      height: 92px;
      margin: -46px 0 0 -46px;
      border-radius: 50%;
      background: var(--ouro);
      color: var(--noite);
      font: 500 0.66rem/1 var(--sans);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      pointer-events: none;
      opacity: 0;
      /* --x e --y vêm do arrastar.js */
      transform: translate3d(var(--x, 0px), var(--y, 0px), 0) scale(0.4);
      transition:
        opacity 0.3s,
        transform 0.35s var(--ease);
    }

    :global(.arrastar.com-cursor) .arrastar__cursor {
      opacity: 1;
      transform: translate3d(var(--x, 0px), var(--y, 0px), 0) scale(1);
      transition:
        opacity 0.3s,
        transform 0.12s linear;
    }

    /* segurando o botão: o círculo encolhe */
    :global(.arrastar.arrastando) .arrastar__cursor {
      transform: translate3d(var(--x, 0px), var(--y, 0px), 0) scale(0.75);
    }
  }
</style>
